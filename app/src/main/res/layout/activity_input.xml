<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SRMIST Pro Tracker"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#333"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="40dp"/>

    <LinearLayout
        android:id="@+id/layoutSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnSyncPortal"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="🔄 Sync from Portal"
            android:textSize="18sp"
            android:backgroundTint="#2196F3"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnManualFill"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="✍️ Fill Manually"
            android:textSize="18sp"
            android:backgroundTint="#4CAF50"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutManual"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update Attendance"
            android:textSize="20sp"
            android:layout_marginBottom="10dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:id="@+id/containerSubjects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <Button
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Generate Dashboard 🚀"
            android:backgroundTint="#2196F3"/>
    </LinearLayout>

</LinearLayout>